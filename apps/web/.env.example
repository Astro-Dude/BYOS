# Web app environment. Copy to .env.local for local development.

# Base URL of the BYOS API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Razorpay payment-button id for the "Buy me a coffee" support link.
# This is a public, client-side identifier (it ends up in the page), but it lives
# here rather than in the source so a self-hosted BYOS doesn't ship someone
# else's donate button. Leave it unset and the feature is hidden entirely.
# NEXT_PUBLIC_RAZORPAY_BUTTON_ID=pl_xxxxxxxxxxxxxx
